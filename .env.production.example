# قالب .env للإنتاج (Hostinger + SQLite)
# انسخه على السيرفر باسم .env ثم عدّل APP_URL فقط، وولّد APP_KEY بالأمر:
#   php artisan key:generate
# ⚠️ لا ترفع ملف .env الحقيقي على git أبدًا (مُتجاهَل في .gitignore).

APP_NAME="Bio-Graphene"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com        # ← غيّرها لدومينك على Hostinger

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# قاعدة البيانات: SQLite (ملف واحد — لا تحتاج يوزر/باسورد)
DB_CONNECTION=sqlite
# ملف القاعدة: database/database.sqlite (يُنشأ بأمر touch — انظر دليل النشر)

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# البريد: log افتراضيًا. لو هتفعّل إرسال رسائل التواصل بالإيميل، املأ بيانات SMTP من hPanel:
MAIL_MAILER=log
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS="info@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
